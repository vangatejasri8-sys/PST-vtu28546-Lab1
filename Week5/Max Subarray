import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];

            for (int i = 0; i < n; i++)
                a[i] = sc.nextInt();

            int current = a[0], best = a[0];
            int nonContiguous = 0, largest = a[0];

            for (int x : a) {
                current = Math.max(x, current + x);
                best = Math.max(best, current);
                largest = Math.max(largest, x);
                if (x > 0)
                    nonContiguous += x;
            }

            if (nonContiguous == 0)
                nonContiguous = largest;

            System.out.println(best + " " + nonContiguous);
        }
    }
}
Input:
2
4
1 2 3 4
6
2 -1 2 3 4 -5
Output:
10 10
10 11
